# At least one key enables live models. With no keys the platform runs in offline mock mode.
OPENROUTER_API_KEY=
GROQ_API_KEY=

# auto | true | false   (auto = mock only when no key is set)
MOCK_MODE=auto
GROQ_MODELS=llama-3.3-70b-versatile,qwen/qwen3-32b,openai/gpt-oss-120b

# Routing: adaptive (telemetry-driven) | static (capability priors only, A/B baseline)
ROUTING_STRATEGY=adaptive
ROUTER_TOP_K=3
ROUTER_EXPLORATION=0.08
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_COOLDOWN_S=60
LLM_TIMEOUT_S=60

# Pipeline defaults
DEFAULT_LANGUAGE=cpp
ACCEPTANCE_SCORE=85
MAX_REPAIRS=4
MAX_REPLANS=1
MAX_REFINEMENTS=1

# Sandbox limits
RUN_TIMEOUT_S=2
MEMORY_LIMIT_MB=512

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
